{
    "version": 2,
    "public": true,
    "functions": {
          "api/**/*.js": {
                  "runtime": "nodejs20.x"
          }
    },
    "routes": [
          {
                  "src": "/api/(.*)",
                  "dest": "/api/$1"
          },
          {
                  "src": "/(.*)\\.html$",
                  "dest": "/$1.html"
          },
          {
                  "src": "/(.*)",
                  "dest": "/admin.html"
          }
    ]
}
